# --- Never commit: large caches & scraped source blobs ---
# data/cache/ holds the 352 MB+ ADM file and downloaded brochures — MUST stay out.
data/cache/

# The WORKING catalog is >1 GB once src/prfbulk.py loads RMA's national rainfall-index
# file (~11.5M rows the app never reads) — far past GitHub's 100 MB file limit.
# The app ships data/catalog_app.db instead (scripts/build_app_db.py), which is committed.
data/catalog.db

# SQLite sidecars, by PATTERN so this covers catalog_app.db too. Named entries used to
# cover only catalog.db, leaving data/catalog_app.db-wal/-shm untracked-but-committable —
# and committing a -wal next to the .db it belongs to means SQLite replays a stale log over
# a newer database on the deploy host. scripts/build_app_db.py now ships the app DB in
# DELETE mode so these should not appear at all; this is the backstop if one ever does.
*.db-wal
*.db-shm

# Recovery copies (e.g. lrp_gap_history.csv.bak, written by scripts/rebuild_gap_history.py
# before it corrects the contaminated premium history). Useful locally, never shipped.
*.bak

# --- Secrets ---
.streamlit/secrets.toml

# --- Python / venv ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- OS cruft ---
.DS_Store

# --- Excel exports (regenerated by the pipeline) ---
# Keep the output/ directory (via .gitkeep) but not the generated workbooks or lock files.
output/*.xlsx
output/~$*.xlsx
# Transient run logs from the rebuild/monthly scripts — machine-specific timings and
# progress counters, regenerated on every run and of no value in history.
output/*.log
output/monthly_log.txt

# --- LRP Signal (lrp_signal.py writes next to itself) ---
# HTTP cache of RMA rate files and CME quotes — re-fetchable, auto-created.
lrp_cache/
# Artifacts from CLI runs (python lrp_signal.py ...) — the Streamlit tab
# renders in-memory and writes neither of these.
lrp_signal_*.csv
lrp_signal_*.png

# --- What we DO commit (documented, do not add ignores for these) ---
# lrp_gap_history.csv      (LRP richness baseline — immutable append-only
#                           snapshot store; the page self-backfills on first
#                           load, but committing it preserves real observed
#                           history across deploys. NOT ignored, on purpose.)
# data/catalog_app.db      (slim app DB — built by scripts/build_app_db.py)
# data/assets/             (d3 / topojson / us-atlas / verify screenshots)
# data/seed/               (curated CSV seeds)
# output/product_map.html  (optional prebuilt map)
