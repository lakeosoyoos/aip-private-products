# Streamlit secrets for the passcode gate — COPY to `.streamlit/secrets.toml`
# and fill in a real value. The real secrets.toml is gitignored and must NEVER
# be committed. On Hugging Face Spaces, set these under Settings → Secrets
# (or the APP_PASSCODE environment variable) instead of a file.

# Single shared passcode (simplest):
app_passcode = "change-me"

# OR a named-user table (any/all of these values are accepted at the gate):
# [passcodes]
# alice = "alice-only-passcode"
# bob   = "bob-only-passcode"

# Fallback (no secrets file): set the APP_PASSCODE environment variable.
