# --- Never commit: large caches & scraped source blobs ---
# data/cache/ holds the 352 MB+ ADM file and downloaded brochures — MUST stay out.
data/cache/

# --- Secrets ---
.streamlit/secrets.toml

# --- Python / venv ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- OS cruft ---
.DS_Store

# --- Excel exports (regenerated by the pipeline) ---
# Keep the output/ directory (via .gitkeep) but not the generated workbooks or lock files.
output/*.xlsx
output/~$*.xlsx

# --- What we DO commit (documented, do not add ignores for these) ---
# data/catalog.db          (6 MB — the catalog, bundled for the app)
# data/assets/             (d3 / topojson / us-atlas / verify screenshots)
# data/seed/               (curated CSV seeds)
# output/product_map.html  (optional prebuilt map)
